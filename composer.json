{
    "name": "phildaiguille/twig-a11y-rules",
    "description": "Accessibility linting rules for Twig templates",
    "type": "library",
    "keywords": [
        "twig",
        "accessibility",
        "a11y",
        "wcag",
        "linter",
        "static-analysis",
        "twig-cs-fixer",
        "symfony",
        "code-quality"
    ],
    "homepage": "https://github.com/PhilDaiguille/twig-a11y-rules",
    "support": {
        "issues": "https://github.com/PhilDaiguille/twig-a11y-rules/issues",
        "source": "https://github.com/PhilDaiguille/twig-a11y-rules"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Phildaiguille",
            "homepage": "https://github.com/PhilDaiguille"
        }
    ],
    "require": {
        "php": ">=8.4",
        "composer-runtime-api": "^2.0",
        "vincentlanglet/twig-cs-fixer": "^4.0.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.23.1",
        "carthage-software/mago": "^1.53.0",
        "infection/infection": "^0.35.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.2.6",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "TwigA11y\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TwigA11y\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests --testdox",
        "fmt": "mago fmt",
        "fmt:check": "mago fmt --check",
        "mago:lint": "mago lint",
        "mago:analyze": "mago analyze",
        "phpstan": "phpstan analyse",
        "rector": "rector --dry-run",
        "rector:apply": "rector",
        "infection": "infection",
        "lint": "composer fmt:check && composer mago:lint && composer mago:analyze && vendor/bin/phpstan --memory-limit=2g && composer test && composer rector",
        "lint:fix": "composer rector:apply && mago lint --fix && composer fmt"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
